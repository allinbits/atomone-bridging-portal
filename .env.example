# Required for AtomOne → EVM e2e tests
TEST_MNEMONIC="your twelve word mnemonic phrase goes here ..."
TEST_EVM_ADDRESS="0xYourEthereumAddress"

# Optional overrides
# ATOMONE_RPC="https://atomone-rpc.allinbits.com/"
# ETH_RPC="https://eth.llamarpc.com"
# BASE_RPC="https://mainnet.base.org"
# TEST_AMOUNT="42000"
# TEST_DENOM="uatone"

# Spectre (AtomOne <-> Sepolia IBC v2) e2e tests
# AtomOne -> Sepolia: needs TEST_MNEMONIC + TEST_EVM_ADDRESS (+ ATOMONE_RPC, defaults to the devnet spectre RPC)
# Sepolia -> AtomOne: needs TEST_EVM_PRIVATE_KEY + TEST_COSMOS_ADDRESS (or TEST_MNEMONIC to derive it)
# TEST_EVM_PRIVATE_KEY="0xYourPrivateKey"
# TEST_COSMOS_ADDRESS="atone1..."
# SEPOLIA_RPC="https://ethereum-sepolia-rpc.publicnode.com"
# TEST_ENABLE_WAIT_FOR_ACK="false"
# Optional deployment overrides (also apply at build time via VITE_SPECTRE_* env vars)
# VITE_SPECTRE_ICS20_ADDRESS="0xf933092b9632ae8b9d9a4984288a52a557848fbf"
# VITE_SPECTRE_COSMOS_RPC="https://atomone-devnet-1-rpc.allinbits.services"
# VITE_SPECTRE_COSMOS_CHAIN_ID="atomone-devnet-1"
# VITE_SPECTRE_COSMOS_CLIENT_ID="spectre-0"
# VITE_SPECTRE_EVM_CLIENT_ID="atomone-1"
# VITE_SPECTRE_ERC20_ADDRESS="0x7d4874e2b462e47750663e9b3b7f8840ec3c376c"
# VITE_SPECTRE_WRAPPED_UATONE_ADDRESS="0x0cBa733eC8473942d8cc94948eB875Dd7976eE3d"
